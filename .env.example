TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_CHAT_ID=@your_channel_username

# Optional. FRED official API key. Create one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=replace_me

# Recommended. Used to synthesize market/news into the final 10-item view.
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=qwen/qwen3-32b:free

# Optional local LLM. Leave OLLAMA_MODEL empty for the cloud/free OpenRouter setup.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT=300

# Optional knobs
REPORT_TITLE=AI Semiconductor 6AM
TIMEZONE=Asia/Seoul
